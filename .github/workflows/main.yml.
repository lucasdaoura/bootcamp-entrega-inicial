name: CI Pipeline

on: [push, pull_request]

jobs:
  testes:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - name: Setup Python
        uses: actions/setup-python@v4
        with:
          python-version: "3.10"
      - name: Instalar dependencias
        run: pip install -r requirements.txt
      - name: Rodar Lint
        run: ruff check .
      - name: Rodar Testes
        run: pytest
